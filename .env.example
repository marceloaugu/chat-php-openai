# Configuração da API compatível com OpenAI (ex.: OpenAI remota, Ollama /v1, vLLM, llama.cpp ou servidor local)
# Ex. Para usar com Ollama troque o valor de OPENAI_BASE_URL por http://127.0.0.1:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Configuração do Banco de Dados MariaDB / MySQL
DB_HOST=localhost
DB_NAME=chat_app
DB_USER=ubuntu
DB_PASS=sua_senha_aqui
